<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/card"
    android:padding="14dp" android:layout_marginBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView android:id="@+id/tDistance" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="" android:textColor="@color/text"
            android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tWhen" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="" android:textColor="@color/textDim"
            android:textSize="12sp" android:gravity="end"/>
    </LinearLayout>
    <TextView android:id="@+id/tDetail" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="" android:textColor="@color/textDim"
        android:textSize="13sp" android:layout_marginTop="6dp"/>
</LinearLayout>
